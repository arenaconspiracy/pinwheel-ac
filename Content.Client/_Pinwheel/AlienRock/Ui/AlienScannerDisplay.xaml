<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'node-scan-display-title'}"
    MinSize="350 200"
    SetSize="350 200"
    Resizable="False"
    >
    <BoxContainer Orientation="Vertical" >
        <controls:StripeBack>
            <Label Name="ScannerStateLabel" HorizontalAlignment="Center" StyleClasses="Highlight" Margin="4 0 0 4" />
        </controls:StripeBack>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="NodesClearedLabel" Text="{Loc 'node-scan-no-data'}" Margin="45 25 0 0" MinHeight="47" />
            <GridContainer Name="NodesList"
                HorizontalAlignment="Center"
                HorizontalExpand="True"
                Columns="2" Rows="3" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
